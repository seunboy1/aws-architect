 "flow": {
  "x": 1510,
  "y": 60,
  "w": 360,
  "steps": [
   "A customer places an order in the browser or mobile app.",
   "CloudFront passes the request to API Gateway.",
   "API Gateway calls the order API.",
   "The API puts the order on the queue and answers at once.",
   "The worker takes the order off the queue.",
   "The worker saves the order and updates its status.",
   "An order that fails three times goes to the dead-letter queue for a person to check."
  ]
 }
