],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_vpc;strokeColor=#8C4FFF;fillColor=none;fontColor=#5A30B5;" vertex="1" parent="acct"><mxGeometry x="30" y="250" width="900" height="410" as="geometry"/></mxCell><mxCell id="managed" value="Managed services · outside the VPC" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#8D99A8;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontColor=#545B64;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;" vertex="1" parent="acct"><mxGeometry x="960" y="250" width="280" height="410" as="geometry"/></mxCell><mxCell id="sec" value="Security and observability · applies to everything" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#8D99A8;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=11;fontColor=#545B64;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;" vertex="1" parent="acct"><mxGeometry x="30" y="685" width="1210" height="140" as="geometry"/></mxCell><mxCell id="priv" value="Private subnet" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;fontColor=#147EBA;" vertex="1" parent="vpc"><mxGeometry x="20" y="45" width="860" height="345" as="geometry"/></mxCell><mxCell id="user" value='&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;&lt;font color="#545B64" style="font-size:10px"&gt;web or mobile&lt;/font&gt;' style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;gradientColor=none;fillColor=#232F3D;strokeColor=none;shape=mxgraph.aws4.user;dashed=0;html=1;fontSize=11;fontColor=#232F3E;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="60" height="60" as="geometry"/></mxCell><mxCell id="cf" value='&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;&lt;font color="#545B64" style="font-size:10px"&gt;static site and API edge&lt;/font&gt;' style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;gradientColor=#945DF2;gradientDirection=north;fillColor=#5A30B5;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;dashed=0;html=1;fontSize=11;fontColor=#232F3E;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="edge"><mxGeometry x="40" y="40" width="60" height="60" as="geometry"/></mxCell><mxCell id="apigw" value='&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font color="#545B64" style="font-size:10px"&gt;REST API&lt;/font&gt;' style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;gradientColor=#FF4F8B;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;dashed=0;html=1;fontSize=11;fontColor=#232F3E;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;" vertex="1" parent="edge"><mxGeometry x="220" y="40" width="60" height="60" as="geometry"/></mxCell><mxCell id="api" value='&lt;b&gt;A